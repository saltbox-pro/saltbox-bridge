{%- set ssh_dir = pillar['ssh_dir'] %}
{%- set known_hosts = ssh_dir + '/known_hosts' %}
Host saltbox-salt-conf
  User {{ pillar['salt_conf_user'] }}
  Hostname {{ pillar['salt_conf_server'] }}
  PasswordAuthentication no
  StrictHostKeyChecking no
  Port {{ pillar['salt_conf_port'] }}
  IdentityFile {{ pillar['salt_conf_privkey'] }}
  UserKnownHostsFile {{ known_hosts }}
{%- if pillar['sshfs_sync_on'] %}

Host saltbox-sshfs
  User {{ pillar['sshfs_user'] }}
  Hostname {{ pillar['sshfs_server'] }}
  PasswordAuthentication no
  StrictHostKeyChecking no
  Port {{ pillar['sshfs_port'] }}
  IdentityFile {{ pillar['sshfs_privkey'] }}
  UserKnownHostsFile {{ known_hosts }}
{%- endif %}
